{
    "input": {
        "dir": "./src",
        "mapping": {
            "pages": "",
            "scripts": "",
            "styles": "",
            "public": ""
        },
        "exclude": [
            "form-types.ts",
            "form-validators.ts",
            "form-utils.ts"
        ],
        "externals": {
            "./node_modules/bootstrap-icons/font/fonts": "fonts"
        }
    },
    "output": {
        "dir": "./dist",
        "replace": {
            "../../node_modules/bootstrap-icons/font/fonts/bootstrap-icons.woff2": "/fonts/bootstrap-icons.woff2",
            "../../node_modules/bootstrap-icons/font/fonts/bootstrap-icons.woff": "/fonts/bootstrap-icons.woff"
        },
        "css": {
            "bundling": true,
            "minify": true,
            "outFile": "style.css"
        },
        "html": {
            "minify": true
        },
        "js": {
            "bundling": true,
            "minify": true,
            "outFile": "scripts.js"
        }
    }
}